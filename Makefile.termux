# Makefile for pixiewps compiled in Termux (Android ARM environment)
# Production-optimized ARM build with vectorization and threading support
#
# Build with: make -f Makefile.termux
# Or: make -f Makefile.termux OPENSSL=1 (for faster SHA-256)
# Or: make -f Makefile.termux OPENMP=1 (for parallel processing)
# Or: make -f Makefile.termux PROFILE=1 (with debugging symbols)

# Detect ARM architecture dynamically
UNAME_M := $(shell uname -m)
UNAME_OS := $(shell uname -s)

# ARM-specific optimization flags
# ARMv8-A (64-bit): Best for modern Android devices
ARMv8_FLAGS = -march=armv8-a -mtune=generic -mfpu=neon -mvectorize-with-neon-quad

# ARMv7-A (32-bit with NEON): For older devices with SIMD support
ARMv7_FLAGS = -march=armv7-a -mfpu=neon -mtune=generic -mfp16-format=ieee

# ARMv6 (older devices, no NEON)
ARMv6_FLAGS = -march=armv6 -mfpu=vfp -mtune=generic

# Architecture detection
ifeq ($(UNAME_M), aarch64)
	ARCH_FLAGS = $(ARMv8_FLAGS)
else ifeq ($(UNAME_M), armv8l)
	ARCH_FLAGS = $(ARMv8_FLAGS)
else ifeq ($(UNAME_M), armv7l)
	ARCH_FLAGS = $(ARMv7_FLAGS)
else ifeq ($(UNAME_M), armv6l)
	ARCH_FLAGS = $(ARMv6_FLAGS)
else
	ARCH_FLAGS = -march=native
endif

# Optimization flags for performance
OPT_FLAGS = -O3 -funroll-loops -fweb -frename-registers -fmerge-all-constants
OPT_FLAGS += -fgcse-sm -fgcse-las -fgcse -fipa-pta

# Additional loop optimizations
LOOP_OPT = -floop-optimize2 -ftree-loop-distribution -ftree-vect-loop-version

# Inline heuristics for hot functions
INLINE_OPT = -finline-functions -finline-small-functions --param inline-unit-growth=200

# Base compiler flags
CFLAGS ?= $(OPT_FLAGS) $(LOOP_OPT) $(INLINE_OPT) $(ARCH_FLAGS)
CFLAGS += -Wall -Wextra -Wno-unused-parameter -Wstrict-prototypes
CFLAGS += -fno-common -fomit-frame-pointer
LDFLAGS ?= -s

# Optional OpenMP multithreading
ifdef OPENMP
	CFLAGS += -fopenmp
	LDFLAGS += -fopenmp
else
	LDFLAGS += -lpthread
endif

# Optional debugging with symbols
ifdef PROFILE
	CFLAGS := $(filter-out -O3,$(CFLAGS)) -O2 -g3 -DDEBUG
	LDFLAGS := $(filter-out -s,$(LDFLAGS))
endif

# Install prefix (Termux-compatible)
PREFIX ?= $(TERMUX_PREFIX)
ifeq ($(PREFIX),)
	PREFIX = /data/data/com.termux/files/usr
endif

BINDIR = $(PREFIX)/bin
MANDIR = $(PREFIX)/share/man

# Source directories
SRCDIR = src
HDRS = $(SRCDIR)/config.h $(SRCDIR)/endianness.h $(SRCDIR)/version.h
HDRS += $(SRCDIR)/pixiewps.h $(SRCDIR)/utils.h $(SRCDIR)/wps.h

# Internal compilation flags
INTFLAGS = -std=c99 -I $(SRCDIR)/crypto/tc -fPIC
LIBS = -lpthread

# Optional OpenSSL for faster SHA-256
ifeq ($(OPENSSL),1)
	LIBS += -lcrypto
	INTFLAGS += -DUSE_OPENSSL
	CFLAGS += -DUSE_OPENSSL
endif

# Optional OpenMP for parallel processing
ifeq ($(OPENMP),1)
	INTFLAGS += -fopenmp
	LIBS += -fopenmp
endif

# Target executable
TARGET = pixiewps

# Include TFM (Tom's Fast Math) sources
include $(SRCDIR)/crypto/tfm/sources.mak
TFMSRC = $(patsubst ./%,$(SRCDIR)/crypto/tfm/%,$(TFM_SRCS))
TFMOBJS = $(TFMSRC:.c=.o)

# Tiny Crypt (AES) sources
TC_SRCS = ./aes_cbc.c ./aes.c
TCSRC = $(patsubst ./%,$(SRCDIR)/crypto/tc/%,$(TC_SRCS))
TCOBJS = $(TCSRC:.c=.o)

# Main source
SOURCE = $(SRCDIR)/pixiewps.c

# Include any local configuration
-include config.mak

.PHONY: all install install-bin install-man strip clean info

info:
	@echo "=== Pixiewps Build Configuration ==="
	@echo "Architecture: $(UNAME_M)"
	@echo "Architecture Flags: $(ARCH_FLAGS)"
	@echo "Compiler: $(CC)"
	@echo "CFLAGS: $(CFLAGS)"
	@echo "PREFIX: $(PREFIX)"
	@echo "OpenSSL Support: $(OPENSSL)"
	@echo "OpenMP Support: $(OPENMP)"
	@echo "===================================="

all: $(TARGET)

pixiewrapper: $(SRCDIR)/pixiewrapper.o
	$(CC) $(INTFLAGS) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $<

$(TARGET): $(SOURCE) $(HDRS) $(TFMOBJS) $(TCOBJS)
	@echo "Building pixiewps for $(UNAME_M)..."
	$(CC) $(INTFLAGS) $(CFLAGS) $(CPPFLAGS) -o $(TARGET) $(SOURCE) \
		$(LIBS) $(LDFLAGS) $(TFMOBJS) $(TCOBJS)
	@echo "Build complete: $(TARGET)"

$(SRCDIR)/crypto/tfm/%.o: $(SRCDIR)/crypto/tfm/%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) $(ARCH_FLAGS) -I$(SRCDIR)/crypto/tfm -c -o $@ $<

$(SRCDIR)/crypto/tc/%.o: $(SRCDIR)/crypto/tc/%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) $(ARCH_FLAGS) -I$(SRCDIR)/crypto/tc -c -o $@ $<

install: install-bin install-man
	@echo "Installation complete to $(PREFIX)"

install-bin: $(TARGET)
	mkdir -p $(BINDIR)
	install -m 755 $(TARGET) $(BINDIR)/

install-man:
	mkdir -p $(MANDIR)/man1
	install -m 644 pixiewps.1 $(MANDIR)/man1/

strip: $(TARGET)
	strip $(TARGET)

clean:
	rm -f $(TARGET)
	rm -f $(SRCDIR)/crypto/tfm/*.o
	rm -f $(SRCDIR)/crypto/tc/*.o
	rm -f $(SRCDIR)/*.o
	rm -f $(SRCDIR)/pixiewrapper.o

.DEFAULT_GOAL := all
